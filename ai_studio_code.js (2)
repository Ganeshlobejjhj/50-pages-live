const API_BASE = "https://api.ar-lottery01.com/api/Lottery/GetHistoryIssuePage";

// Helper: Standardize response data
function parseItem(item) {
  const issueNumber = String(item.issueNumber || item.issue || item.period || item.periodNumber || item.IssueNumber || item.id || '');
  const num = Number(item.number ?? item.winningNumber ?? item.premium ?? item.code ?? item.result ?? 0);
  const isBig = num >= 5;
  let color = 'Red';
  if (num === 0) color = 'Red + Violet';
  else if (num === 5) color = 'Green + Violet';
  else if ([1, 3, 7, 9].includes(num)) color = 'Green';

  const time = item.formattedTime || (item.openTime ? new Date(item.openTime).toLocaleTimeString() : new Date().toLocaleTimeString());
  return { issueNumber, number: num, size: isBig ? 'Big' : 'Small', color, formattedTime: time };
}

// Single page fetcher
async function fetchPage(pageNo, pageSize, token) {
  const random = Math.floor(100000000000 + Math.random() * 900000000000).toString();
  const timestamp = Math.floor(Date.now() / 1000).toString();
  const signature = '7A8DF629CD880F2DF720D8EF2D0E9183';

  const url = `${API_BASE}?gameCode=WinGo_30S&pageNo=${pageNo}&pageSize=${pageSize}&language=en&random=${random}&signature=${signature}&timestamp=${timestamp}`;

  const res = await axios.get(url, {
    headers: {
      'accept': 'application/json, text/plain, */*',
      'authorization': token,
      'user-agent': 'Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Mobile Safari/537.36'
    },
    timeout: 8000
  });

  // Check if server refreshed token in response headers
  const freshTok = res.headers['authorization'] || res.headers['bearer'];
  if (freshTok && freshTok.length > 20) {
    cachedAuthToken = freshTok.startsWith('Bearer ') ? freshTok : `Bearer ${freshTok}`;
  }

  const resData = res.data;
  const list = resData?.data?.list || resData?.data?.data?.list || resData?.list || [];
  return Array.isArray(list) ? list.map(parseItem).filter(r => Boolean(r.issueNumber)) : [];
}

// Vercel Serverless Function Handler
module.exports = async (req, res) => {
  // CORS Headers
  res.setHeader('Access-Control-Allow-Credentials', 'true');
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET,OPTIONS,POST,PUT');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, x-authorization');

  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
  const pathname = url.pathname;

  // 1. Update Bearer Token endpoint
  if (pathname === '/api/token') {
    const newTok = req.query.token || (req.body && req.body.token);
    if (newTok) {
      cachedAuthToken = newTok.startsWith('Bearer ') ? newTok : `Bearer ${newTok}`;
      return res.json({ success: true, message: "Token updated successfully", token: cachedAuthToken });
    }
    return res.json({ currentToken: cachedAuthToken });
  }

  // 2. Single Page Endpoint: /api/history?pageNo=1&pageSize=10
  if (pathname === '/api/history') {
    const pageNo = parseInt(req.query.pageNo || '1', 10);
    const pageSize = parseInt(req.query.pageSize || '10', 10);
    const token = req.headers['authorization'] || req.query.token || cachedAuthToken;

    try {
      const records = await fetchPage(pageNo, pageSize, token);
      return res.json({ success: true, pageNo, pageSize, count: records.length, data: records });
    } catch (err) {
      return res.status(500).json({ success: false, error: err.message, response: err.response?.data });
    }
  }

  // 3. Batch 50-Pages (500 Draws) Endpoint: /api/all-500
  if (pathname === '/api/all-500') {
    const token = req.headers['authorization'] || req.query.token || cachedAuthToken;
    const totalPages = 50;
    const batchSize = 5;
    const recordsMap = new Map();

    try {
      for (let i = 1; i <= totalPages; i += batchSize) {
        const batchPages = [];
        for (let b = 0; b < batchSize && (i + b) <= totalPages; b++) {
          batchPages.push(i + b);
        }

        const results = await Promise.all(
          batchPages.map(page => fetchPage(page, 10, token).catch(() => []))
        );

        results.flat().forEach(r => recordsMap.set(r.issueNumber, r));
      }

      const sorted = Array.from(recordsMap.values()).sort((a, b) =>
        b.issueNumber.localeCompare(a.issueNumber, undefined, { numeric: true })
      );

      return res.json({
        success: true,
        count: sorted.length,
        totalPages: 50,
        data: sorted
      });
    } catch (err) {
      return res.status(500).json({ success: false, error: err.message, count: recordsMap.size });
    }
  }

  // 4. Root Endpoint: Serve HTML Dashboard
  res.setHeader('Content-Type', 'text/html; charset=utf-8');
